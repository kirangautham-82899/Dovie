NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: enables "Ask Dovie" AI insights (server-only, never NEXT_PUBLIC_).
# Set one. Gemini is used when GEMINI_API_KEY is set, otherwise Claude.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
ANTHROPIC_API_KEY=

# Optional: your custom domain, used for canonical URLs, the sitemap and share cards
# (on Vercel the production URL is detected automatically)
NEXT_PUBLIC_SITE_URL=
