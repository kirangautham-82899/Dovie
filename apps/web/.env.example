NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: enables "Ask Dovie" AI insights (server-only, never NEXT_PUBLIC_).
# Set one. Gemini is used when GEMINI_API_KEY is set, otherwise Claude.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
ANTHROPIC_API_KEY=

# Optional: your custom domain, used for canonical URLs, the sitemap and share cards
# (on Vercel the production URL is detected automatically)
NEXT_PUBLIC_SITE_URL=

# Support and grievance inbox, shown on the privacy, terms and data-request pages
NEXT_PUBLIC_SUPPORT_EMAIL=

# Optional: error reports. The DSN of a Sentry Next.js project (docs/deploy.md).
NEXT_PUBLIC_SENTRY_DSN=
# Only while checking that reports arrive: enables /api/monitoring-test
# MONITORING_TEST=1

# Optional: 1 shows the email bill reminder switch, once the sender is set up
# (docs/bill-reminders.md)
NEXT_PUBLIC_EMAIL_REMINDERS=

# Optional: search engine ownership codes (the content="..." value only).
# Google Search Console and Bing Webmaster Tools (Bing also powers Edge).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
